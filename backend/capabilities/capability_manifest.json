    },
    {
      "name": "expression.set",
      "version": 1,
      "category": "expression",
      "description": "Set a semantic facial expression with bounded intensity and hold; neutral explicitly releases.",
      "argument_schema": {
        "type": "object",
        "required": [
          "expression"
        ],
        "additionalProperties": false,
        "properties": {
          "expression": {
            "type": "string",
            "enum": [
              "neutral",
              "happy",
              "concerned",
              "surprised",
              "relaxed",
              "shy"
            ]
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.6
          },
          "hold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "default": 3
          }
        }
      },
      "side_effect": "expression",
      "priority_class": "normal",
      "idempotency": "call_id_once_per_avatar_session",
      "availability_policy": "expression_state_v1",
      "preconditions": [
        "active_bound_turn",
        "orchestrator_authorization"
      ],
      "executor": "unity.orchestrator",
      "completion_semantics": "dispatch_acknowledgement_only"
    },
