{
  "registry_version": 1,
  "tools": [
    {
      "name": "gesture.nod",
      "version": 1,
      "category": "gesture",
      "description": "Perform one head nod through the current behavior policy.",
      "argument_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "side_effect": "gesture",
      "priority_class": "normal",
      "idempotency": "call_id_once_per_avatar_session",
      "availability_policy": "gesture_state_v1",
      "preconditions": [
        "active_bound_turn",
        "orchestrator_authorization"
      ],
      "executor": "unity.orchestrator",
      "completion_semantics": "dispatch_acknowledgement_only"
    },
    {
      "name": "gesture.wave",
      "version": 1,
